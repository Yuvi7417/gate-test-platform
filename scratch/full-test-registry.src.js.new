registerTest({
  series: "cs-gate-classes",
  name: "FST - Mock test-4",
  date: "November 27, 2026",
  questions: [
    {
      marks: 1,
      neg: 0.33,
      type: "MCQ",
      text: `<p>Which of the following functions \\(f\\) defined for all numbers \\(x\\) has the property that \\(f(-x)=-f(x)\\) for all numbers \\(x?\\) <br/> </p> <p></p>`,
      image: "",
      options: [
        `\\(f(x)=\\frac{x^3}{x^2+1}\\)`,
        `\\(f(x)=\\frac{x^2-1}{x^2+1}\\)`,
        `\\(f(x)=x^2\\left(x^2-1\\right)\\)`,
        `\\(f(x)=x\\left(x^3-1\\right)\\)`,
